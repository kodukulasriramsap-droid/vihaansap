# Backend API URL (Use http://localhost:5000 for local dev, or https://your-backend.onrender.com for production)
VITE_API_URL=http://localhost:5000/api

# Firebase Client Configuration (From Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-app-id:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-YOURID

# Company Branding & Contact Information
VITE_COMPANY_NAME="Sri Vihaan SAP Consulting"
VITE_SUPPORT_EMAIL="info@vihaanconsulting.com"
VITE_SUPPORT_PHONE="+91 90595 19899"
VITE_WHATSAPP_NUMBER="+91 90595 19899"

# Social Media Links
VITE_FACEBOOK_URL="https://facebook.com/yourpage"
VITE_INSTAGRAM_URL="https://instagram.com/yourpage"
VITE_LINKEDIN_URL="https://linkedin.com/company/yourpage"
VITE_YOUTUBE_URL="https://youtube.com/c/yourchannel"
