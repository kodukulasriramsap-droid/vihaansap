rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && request.auth.token.email in [
        'riteshgali45@gmail.com',
        'vihaansapconsultancy@gmail.com'
      ];
    }
    match /public/{allPaths=**} { allow read: if true; allow write: if admin(); }
    match /student-files/{uid}/{allPaths=**} {
      allow read, write: if admin() || (request.auth != null && request.auth.uid == uid);
    }
    // Mentor-scoped upload path.
    // A mentor can only write to their OWN UID sub-folder, preventing cross-mentor access.
    // Students have no path here and the catch-all below restricts them to admin-only.
    // Admins retain full access via the catch-all.
    match /mentor-uploads/{mentorUid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == mentorUid;
    }
    match /{allPaths=**} { allow read, write: if admin(); }
  }
}