PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Service Account (From Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Web3Forms API Key
WEB3FORMS_KEY=your-web3forms-key

# WhatsApp Integration
WHATSAPP_ACCESS_TOKEN=your_meta_app_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ADMIN_PHONE_NUMBER=919876543210
WHATSAPP_API_VERSION=v20.0
